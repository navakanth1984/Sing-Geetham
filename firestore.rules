rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if true;
    }
    match /jams/{jamId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
